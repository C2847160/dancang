# ─────────────────────────────────────────────────────────────
# 环境变量参考清单
#
# 本文件不会自动加载。项目没有引入 dotenv，服务端直接读 process.env，
# 因此下列变量需要在启动前注入到 shell 环境（示例见文件末尾）。
# 复制为 .env 仅作为个人备忘，除非你自行接入了加载器。
# ─────────────────────────────────────────────────────────────

# 后端监听端口（apps/server/src/server.ts，默认 3100）
# 3000 常被其他本地项目占用，故默认改用 3100。
# 修改后必须同步更新 apps/web/vite.config.ts 里的 /api 代理目标，
# 否则前端仍会请求旧端口。
PORT=3100

# ─────────────────────────────────────────────────────────────
# 注入方式
#
# bash / zsh:
#   PORT=3200 pnpm --filter @repo/server dev
#
# Windows PowerShell:
#   $env:PORT=3200; pnpm --filter @repo/server dev
# ─────────────────────────────────────────────────────────────
