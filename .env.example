# ─────────────────────────────────────────────────────────────
# 环境变量参考清单
#
# 本文件不会自动加载。项目没有引入 dotenv，服务端直接读 process.env，
# 因此下列变量需要在启动前注入到 shell 环境（示例见文件末尾）。
# 复制为 .env 仅作为个人备忘，除非你自行接入了加载器。
#
# 例外：apps/web 使用 Vite，它会自动加载 apps/web/.env* 并做变量替换。
# ─────────────────────────────────────────────────────────────

# ── 后端（apps/server）──

# 后端监听端口（apps/server/src/server.ts，默认 3100）
# 3000 常被其他本地项目占用，故默认改用 3100。
# 修改后必须同步更新 apps/web/vite.config.ts 里的 /api 代理目标，
# 否则前端仍会请求旧端口。
PORT=3100

# ── 前端（apps/web）──
# Vite 只在构建时内联 VITE_ 前缀变量，修改后需重新构建/重新部署。

# 后端绝对地址，例如 https://dancang-api.example.com（不要带结尾斜杠和 /api）。
# 留空：本地开发走 Vite 代理访问 3100；线上构建则自动进入内置演示数据模式。
VITE_API_BASE_URL=

# 设为 true 时强制使用内置演示数据（即使 VITE_API_BASE_URL 已配置）。
VITE_USE_MOCK_API=

# ─────────────────────────────────────────────────────────────
# 注入方式
#
# bash / zsh:
#   PORT=3200 pnpm --filter @repo/server dev
#   VITE_API_BASE_URL=https://api.example.com pnpm --filter @repo/web build
#
# Windows PowerShell:
#   $env:PORT=3200; pnpm --filter @repo/server dev
#   $env:VITE_API_BASE_URL="https://api.example.com"; pnpm --filter @repo/web build
#
# 线上（Vercel）：在 Project Settings → Environment Variables 里配置，
# 然后重新部署（Vite 变量是构建时注入的，改完必须 redeploy）。
# ─────────────────────────────────────────────────────────────
