{
  "name": "ai-monorepo",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "Open-source AI engineering monorepo — apps/web (React + Vite) + apps/server (Express), with strict frontend/backend separation.",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r test",
    "typecheck": "tsc -b",
    "check:deps": "depcruise apps packages"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^9.18.0",
    "eslint-plugin-boundaries": "^5.0.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^16.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^5.0.5"
  }
}
